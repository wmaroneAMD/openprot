load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "bootlog_receiver",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "openprot_bootlog_receiver",
    edition = "2024",
    deps = [
        "//services/bootlog",
        "//services/mctp/api:mctp_api",
    ],
)

rust_test(
    name = "bootlog_receiver_test",
    crate = ":bootlog_receiver",
)

rust_doc(
    name = "bootlog_receiver_doc",
    crate = ":bootlog_receiver",
)
