load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "bootlog",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "openprot_bootlog",
    edition = "2024",
)

rust_test(
    name = "bootlog_test",
    crate = ":bootlog",
)

rust_doc(
    name = "bootlog_doc",
    crate = ":bootlog",
)
